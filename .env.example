# ============================================================
# 知诊 · 中医智能问诊 环境配置示例
# 复制为 .env 并填入真实值，切勿将真实密钥提交到仓库/镜像
# ============================================================

# ---------- 运行环境 ----------
# dev / staging / production（生产校验使用 production）
APP_ENV=dev
# 多租户开关（单租户直客模式恒为 false，字段保留）
MULTI_TENANT=false

# ---------- 安全 ----------
# JWT 签名密钥（生产环境务必更换为随机长字符串）
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
# 字段级加密主密钥，AES-256-GCM 要求 32 字节；用 urandom 生成后 base64
# 生成方式：python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=change-me-32-byte-base64-key-please-generate
# 业务数据留存配置占位；尚未接通业务表自动清理。记忆 TTL 见 MEMORY_*。
DATA_RETENTION_DAYS=365

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=tcm-root-password
MYSQL_DATABASE=tcm
MYSQL_USER=tcm
MYSQL_PASSWORD=tcm-password
MYSQL_HOST=mysql
MYSQL_PORT=3306

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0
# Celery broker/result（可用独立 DB 索引）
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---------- PostgreSQL（智能体长短期记忆库，当前问诊链路必需） ----------
POSTGRES_USER=tcm
POSTGRES_PASSWORD=tcm-pg-password
POSTGRES_DB=tcm_memory
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---------- Neo4j ----------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=tcm-neo4j-password

# ---------- Milvus ----------
MILVUS_HOST=milvus
MILVUS_PORT=19530

# ---------- 阿里云 DashScope（多模态 + 文本 + Embedding） ----------
# 兼容 OpenAI 协议接入地址
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-your-dashscope-api-key
# 文本模型（辨证论治）
TEXT_MODEL=qwen-plus
# 文本备用模型（降级）
TEXT_MODEL_FALLBACK=qwen-plus
# 多模态模型（舌象/面色识别）
VISION_MODEL=qwen-vl-max
VISION_MODEL_FALLBACK=qwen-vl-plus
VISION_TIMEOUT_SECONDS=120
# Embedding 模型与维度
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
# 外部 LLM 调用超时(秒)
LLM_TIMEOUT_SECONDS=10
LLM_MAX_RETRIES=2

# ---------- 观测 ----------
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
# 前端可访问的 API 地址（无意义于容器内部，保留占位）
VITE_API_BASE=/api/v1

# ---------- 免责声明（可被管理员动态覆盖） ----------
DISCLAIMER_TEXT=本结果由 AI 生成，仅供参考，不构成医疗诊断、治疗方案或处方建议，不能替代执业医师的当面诊断。若身体不适，请及时前往正规医疗机构就诊，切勿自行用药。
# Agent memory and bounded execution
MEMORY_SHORT_TTL_HOURS=24
MEMORY_LONG_TTL_DAYS=365
MEMORY_MAX_ITEMS=20
AGENT_MAX_TOOL_CALLS=16
# Parent-based trace sampling (use 1.0 in local trace validation)
OTEL_SAMPLE_RATIO=0.1
# Opt-in only; inputs/outputs hidden by application client
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=zhizhen
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

CORS_ORIGINS=["http://localhost","http://localhost:5173"]
